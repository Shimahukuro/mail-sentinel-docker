# IMAP connection (implicit TLS / IMAPS only in the first PoC)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS_MODE=implicit
IMAP_USERNAME=user@example.com
IMAP_INBOX=INBOX
IMAP_JUNK=Junk

# Optional user-feedback learning. Create both IMAP folders before enabling.
LEARNING_ENABLED=false
IMAP_LEARN_HAM=Learn-Ham
IMAP_LEARN_SPAM=Learn-Spam
LEARNED_FLAG=MailSentinelLearned
LEARNING_BATCH_SIZE=25

# Polling and safety limits
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=25
LOOKBACK_DAYS=1
IMAP_TIMEOUT_SECONDS=30
SPAMC_MAX_SIZE_BYTES=10485760
PROCESSED_FLAG=MailSentinelChecked
CREATE_MISSING_FOLDERS=false
DRY_RUN=true
RETRY_INITIAL_SECONDS=5
RETRY_MAX_SECONDS=300

# Optional operator-controlled revision included in initial-scan rule-set IDs.
# Change this when an external SpamAssassin configuration changes.
RULESET_MARKER=

# Path on the Docker host. The file must contain only the IMAP password.
IMAP_PASSWORD_SECRET_FILE=./secrets/imap_password
