# IMAP connection (implicit TLS / IMAPS only in the first PoC)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=user@example.com
IMAP_INBOX=INBOX
IMAP_JUNK=Junk

# Polling and safety limits
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=25
LOOKBACK_DAYS=1
IMAP_TIMEOUT_SECONDS=30
SPAMC_MAX_SIZE_BYTES=10485760
PROCESSED_FLAG=MailSentinelChecked

# Path on the Docker host. The file must contain only the IMAP password.
IMAP_PASSWORD_SECRET_FILE=./secrets/imap_password
