{
  "accounts": [
    {
      "name": "test",
      "environment": {
        "IMAP_HOST": "greenmail",
        "IMAP_PORT": 3143,
        "IMAP_TLS_MODE": "none",
        "IMAP_USERNAME": "test@test.local",
        "IMAP_AUTH_METHOD": "password",
        "IMAP_PASSWORD_FILE": "/run/secrets/imap_password",
        "IMAP_INBOX": "INBOX",
        "IMAP_JUNK": "Junk",
        "LEARNING_ENABLED": true,
        "IMAP_LEARN_HAM": "Learn-Ham",
